PORT=4000
NODE_ENV=development

# In-memory fixtures for social/profile/history/saved/invites/user search (per logged-in user). Auth still uses Firebase Admin.
# USE_MOCK_DATA=true

# Comma-separated origins for CORS (e.g. http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin — use one of:
# 1) Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=

# 2) Or set FIREBASE_PROJECT_ID and paste service account fields (if using custom init)

# Firestore emulator (optional): host:port
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# AI provider: mock | lmstudio | openai | anthropic | ollama
AI_PROVIDER=mock

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LM Studio / Ollama OpenAI-compatible base URL (no trailing slash)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
